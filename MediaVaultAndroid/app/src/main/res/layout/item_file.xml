<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp">
    <TextView android:id="@+id/iconText" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="22sp" />
    <TextView android:id="@+id/nameText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="17sp" />
</LinearLayout>
