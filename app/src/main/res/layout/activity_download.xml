<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <EditText android:id="@+id/urlEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="直接ダウンロードURL（https://...）" android:inputType="textUri" />
    <EditText android:id="@+id/fileNameEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="保存ファイル名 例: movie.mp4" />
    <Button android:id="@+id/startDownloadButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ダウンロード開始" />
    <TextView android:id="@+id/noteText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:text="権利上ダウンロード可能な直接URLのみ利用してください。DRM回避には対応していません。" />
</LinearLayout>
